{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./dist",
    "preserveWatchOutput": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve"
  },
  "exclude": ["node_modules"]
}
