---
import LoadingIcon from '../assets/icons/circle-notch.svg';
import Label from './article/Label.astro';

interface Props {
  id?: string;
  title?: string;
  description?: string;
  class?: string;
}

const {
  id,
  title = 'Just a moment',
  description = 'Please wait while we finish this up.',
  class: className,
} = Astro.props;
---

<div id={id} class:list={['space-y-8', className]}>
  <header>
    <Label>Newsletter</Label>
    <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
      {title}
    </h1>
    <p class="mt-4 leading-relaxed text-zinc-300">
      {description}
    </p>
  </header>

  <aside
    class="border-l-2 border-zinc-700 py-1 pl-6 [&_p]:mt-3 [&_p]:italic [&_p]:leading-relaxed [&_p]:text-zinc-300"
  >
    <div class="flex items-center gap-2">
      <LoadingIcon class="w-5 shrink-0 animate-spin fill-current" />
      <Label class="!mt-0">Working</Label>
    </div>
    <p>This should only take a second.</p>
  </aside>
</div>
