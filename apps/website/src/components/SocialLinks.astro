---
import BlueSky from '../assets/social/bluesky.svg';
import Discord from '../assets/social/discord.svg';
import Facebook from '../assets/social/facebook.svg';
import GitHub from '../assets/social/github.svg';
import Instagram from '../assets/social/instagram.svg';
import Mastodon from '../assets/social/mastodon.svg';
import Matrix from '../assets/social/matrix.svg';
import Proton from '../assets/social/proton.svg';
import Threads from '../assets/social/threads.svg';
import TikTok from '../assets/social/tiktok.svg';
import X from '../assets/social/x.svg';
import Youtube from '../assets/social/youtube.svg';

const ICON_SIZE = 16;
---

<div class="flex flex-wrap gap-4 fill-white justify-center">
  <a
    href="https://discord.gg/pNTmzvd7pe"
    target="_blank"
    title="The Civia Project Discord Community"
    class="visited:fill-white"
  >
    <Discord width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://matrix.to/#/#the-civia-project:matrix.org"
    target="_blank"
    title="The Civia Project Matrix Community"
    class="visited:fill-white"
  >
    <Matrix width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://www.youtube.com/@theciviaproject
"
    target="_blank"
    title="The Civia Project on Youtube"
    class="visited:fill-white"
  >
    <Youtube width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://x.com/theciviaproject"
    target="_blank"
    title="The Civia Project on X"
    class="visited:fill-white"
  >
    <X width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://bsky.app/profile/theciviaproject.org"
    target="_blank"
    title="The Civia Project on Bluesky"
  >
    <BlueSky width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://www.instagram.com/theciviaproject"
    target="_blank"
    title="The Civia Project on Instagram"
    class="visited:fill-white"
  >
    <Instagram width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://www.facebook.com/theciviaproject"
    target="_blank"
    title="The Civia Project on Facebook"
    class="visited:fill-white"
  >
    <Facebook width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://www.threads.com/@theciviaproject"
    target="_blank"
    title="The Civia Project on Threads"
    class="visited:fill-white"
  >
    <Threads width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://mastodon.social/@theciviaproject"
    target="_blank"
    title="The Civia Project on Mastodon"
    class="visited:fill-white"
  >
    <Mastodon width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://www.tiktok.com/@theciviaproject"
    target="_blank"
    title="The Civia Project on TikTok"
    class="visited:fill-white"
  >
    <TikTok width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="https://github.com/the-civia-project"
    target="_blank"
    title="The Civia Project on Github"
    class="visited:fill-white"
  >
    <GitHub width={ICON_SIZE} height={ICON_SIZE} />
  </a>
  <a
    href="mailto:theciviaproject@protonmail.com"
    target="_blank"
    title="theciviaproject@protonmail.com"
    class="visited:fill-white"
  >
    <Proton width={ICON_SIZE} height={ICON_SIZE} />
  </a>
</div>
