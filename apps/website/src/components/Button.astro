---
import { twMerge } from 'tailwind-merge';

interface Props {
  class?: string;
}

const { class: class_list } = Astro.props;
---

<button
  class={twMerge(
    class_list,
    'text-center grow md:grow-0 inline-flex items-center justify-center uppercase p-2 md:px-12 underline underline-offset-8 decoration-transparent ease-in-out duration-500 opacity-50 hover:opacity-100 hover:bg-white hover:text-black cursor-pointer',
  )}
>
  <slot />
</button>
