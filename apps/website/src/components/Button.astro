---
import { twMerge } from 'tailwind-merge';

interface Props {
  class?: string;
}

const { class: class_list } = Astro.props;
---

<button
  class={twMerge(
    class_list,
    'text-center uppercase',
    'md:grow-0 inline-flex items-center justify-center',
    'p-2 md:px-12',
    'text-white bg-black opacity-50 hover:bg-white hover:text-black cursor-pointer hover:opacity-100',
    'transition-colors',
  )}
>
  <slot />
</button>
