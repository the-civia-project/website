---
import { Image } from 'astro:assets';
import Explore from './Explore.astro';
import MailboxRegistry from './MailboxRegistry.astro';
import SocialLinks from './SocialLinks.astro';

const start_year = 2025;
const end_year = new Date().getFullYear();
---

<div class="flex flex-col gap-5 items-stretch">
  <Explore />

  <div class="flex flex-col gap-8">
    <hr class="opacity-25" />

    <MailboxRegistry />

    <hr class="opacity-25" />
  </div>

  <SocialLinks />

  <div
    class="text-xs flex flex-row flex-wrap gap-2 justify-center items-center text-center opacity-50 text-shadow-lg"
  >
    <span
      >&copy; {
        start_year === end_year ? (
          end_year
        ) : (
          <Fragment>
            {start_year} &mdash; {end_year}
          </Fragment>
        )
      }</span
    >
    <span>The Civia Project</span>
  </div>

  <div class="flex items-center justify-center text-xs opacity-50 gap-3">
    <a href="/privacy" class="hover:underline">Privacy Policy</a>
    <a href="/about" class="hover:underline">About</a>
  </div>

  <div
    class="text-xs flex flex-wrap gap-1 justify-center items-center content-center opacity-50"
  >
    <span>Content licensed under</span>
    <a
      class="hover:opacity-100"
      target="_blank"
      href="https://creativecommons.org/licenses/by-sa/4.0/"
    >
      CC BY-SA 4.0
    </a>
    <Image
      loading="eager"
      height={16}
      width={16}
      alt="CC"
      class="inline w-4"
      src="https://mirrors.creativecommons.org/presskit/icons/cc.svg"
    />
    <Image
      loading="eager"
      height={16}
      width={16}
      alt="BY"
      class="inline w-4"
      src="https://mirrors.creativecommons.org/presskit/icons/by.svg"
    />
    <Image
      loading="eager"
      height={16}
      width={16}
      alt="SA"
      class="inline w-4"
      src="https://mirrors.creativecommons.org/presskit/icons/sa.svg"
    />
  </div>
</div>
