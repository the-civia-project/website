---
import ArrowSquareOutIcon from '../assets/icons/arrow-square-out.svg';

interface Props {
  href: string;
  showSection?: boolean;
  class?: string;
}

const { href, showSection: show_section = false, class: className } =
  Astro.props;

const is_internal = !href.startsWith('http');
---

{
  is_internal ? (
    <a
      href={href}
      rel="prefetch"
      class:list={[
        // group
        'group',
        // layout
        'inline',
        // color
        'text-zinc-950 dark:text-white',
        className,
      ]}
    >
      <span
        class:list={[
          // typography
          'underline decoration-zinc-300 underline-offset-2',
          // interactive
          'group-hover:decoration-zinc-950 dark:decoration-zinc-600 dark:group-hover:decoration-white',
        ]}
      >
        {show_section && <span aria-hidden="true">&sect;</span>}
        <slot />
      </span>
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        // group
        'group',
        // layout
        'inline inline-flex items-baseline gap-1',
        // color
        'text-zinc-950 dark:text-white',
        className,
      ]}
    >
      <span
        class:list={[
          // typography
          'underline decoration-zinc-300 underline-offset-2',
          // interactive
          'group-hover:decoration-zinc-950 dark:decoration-zinc-600 dark:group-hover:decoration-white',
        ]}
      >
        <slot />
      </span>
      <ArrowSquareOutIcon
        class:list={[
          // layout
          'inline-block shrink-0 align-text-bottom size-4',
          // color
          'fill-current',
          // interactive
          'opacity-50 group-hover:opacity-100',
          // transitions
          'transition-opacity',
        ]}
        aria-hidden="true"
      />
    </a>
  )
}
