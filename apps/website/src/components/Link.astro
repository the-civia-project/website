---
import ArrowSquareOutIcon from '../assets/icons/arrow-square-out.svg';

interface Props {
  href: string;
  showSection?: boolean;
  class?: string;
}

const { href, showSection: show_section = false, class: className } =
  Astro.props;

const is_internal = !href.startsWith('http');
---

{
  is_internal ? (
    <a
      href={href}
      rel="prefetch"
      class:list={['group', 'inline text-white', className]}
    >
      <span class="underline decoration-zinc-600 underline-offset-2 group-hover:decoration-white">
        {show_section && <span aria-hidden="true">&sect;</span>}
        <slot />
      </span>
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'group',
        'text-white',
        'inline',
        'inline-flex items-baseline gap-1',
        className,
      ]}
    >
      <span class="underline decoration-zinc-600 underline-offset-2 group-hover:decoration-white">
        <slot />
      </span>
      <ArrowSquareOutIcon
        class:list={[
          'inline-block',
          'shrink-0',
          'align-text-bottom',
          'size-4',
          'fill-current',
          'opacity-50',
          'group-hover:opacity-100',
          'transition-opacity',
        ]}
        aria-hidden="true"
      />
    </a>
  )
}
