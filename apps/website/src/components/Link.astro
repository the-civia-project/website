---
type Variant = 'default' | 'secondary';

interface Props {
  path: string;
  isCurrent?: boolean;
  variant?: Variant;
  class?: string;
}

const {
  path,
  isCurrent: is_current = false,
  variant = 'default',
  class: className,
} = Astro.props;

const has_icon = Astro.slots.has('icon');

const variants: Record<Variant, string> = {
  default:
    'border-white/50 text-black bg-white shadow-2xl hover:shadow-white/50',
  secondary:
    'border-zinc-600 bg-zinc-800 text-zinc-100 shadow-2xl hover:border-white/50 hover:bg-white hover:text-black hover:shadow-white/50',
};
---

<a
  href={path}
  rel="prefetch"
  class:list={[
    'whitespace-pre',
    'text-center inline-flex items-center justify-center',
    has_icon && 'gap-2',
    'p-4',
    'uppercase underline underline-offset-8 decoration-transparent',
    'ease-in-out duration-500',
    'border rounded-md',
    variants[variant],
    is_current ? 'decoration-white' : '',
    className,
  ]}
>
  {
    has_icon && (
      <span class="inline-flex shrink-0 items-center [&>svg]:size-5">
        <slot name="icon" />
      </span>
    )
  }
  <slot />
</a>
