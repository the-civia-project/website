---
import { twMerge } from 'tailwind-merge';

interface Props {
  path: string;
  isCurrent?: boolean;
  class?: string;
}

const { path, isCurrent: is_current = false } = Astro.props;
---

<a
  href={path}
  rel="prefetch"
  class={twMerge(
    'whitespace-pre',
    'text-center inline-flex items-center justify-center',
    'p-4',
    'uppercase underline underline-offset-8 decoration-transparent',
    'ease-in-out duration-500',
    'border border-white/50 rounded-md',
    'text-black bg-white shadow-2xl hover:shadow-white/50',
    is_current ? 'decoration-white' : '',
    Astro.props.class,
  )}
>
  <slot />
</a>
