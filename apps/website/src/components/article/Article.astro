---
const content = await Astro.slots.render('default');
const has_references = Astro.slots.has('references');
const references = has_references ? await Astro.slots.render('references') : '';
---

<article
  class:list={[
    // screen — section content
    '[&_aside_p]:!mt-0',
    '[&_section_em]:text-zinc-200',
    '[&_section_p]:mt-4 [&_section_p]:leading-relaxed [&_section_p]:text-zinc-300',
    '[&_section_strong]:font-semibold [&_section_strong]:text-white',
    '[&_section_ul]:mt-4 [&_section_ul]:space-y-4',
    // print — typography
    'print:text-zinc-700',
    '[&_p]:print:text-zinc-700',
    '[&_li]:print:text-zinc-700',
    '[&_em]:print:text-zinc-700',
    '[&_strong]:print:font-semibold [&_strong]:print:text-zinc-950',
    '[&_h1]:print:text-7xl [&_h1]:print:leading-tight [&_h1]:print:text-zinc-950',
    '[&_h2]:print:text-4xl [&_h2]:print:font-bold [&_h2]:print:text-zinc-950',
    '[&_h3]:print:text-2xl [&_h3]:print:font-semibold [&_h3]:print:text-zinc-950',
    '[&_section_p]:print:text-zinc-700',
    '[&_section_em]:print:text-zinc-700',
    '[&_section_strong]:print:text-zinc-950',
    // print — page breaks
    '[&_h2+p]:print:break-before-avoid-page [&_h2+p]:print:break-inside-avoid',
    '[&_h3+p]:print:break-before-avoid-page [&_h3+p]:print:break-inside-avoid',
  ]}
>
  <Fragment set:html={content} />
  {has_references && <Fragment set:html={references} />}
</article>
