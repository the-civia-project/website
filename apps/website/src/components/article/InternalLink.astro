---
type Variant = 'inline' | 'heading' | 'plain';

import {
  formatInternalLinkLabel,
  registerPrintReference,
} from '../../lib/print-references';

interface Props {
  href: string;
  variant?: Variant;
  class?: string;
  /** Document title for breadcrumb labels, e.g. "Social Paper". */
  paper?: string;
  /** Part / H2 title. */
  section?: string;
  /** H3 title; omit when linking to a part only. */
  heading?: string;
}

const { href, variant = 'inline', class: className, paper, section, heading } =
  Astro.props;

const has_breadcrumb = Boolean(paper || section);

const ref = paper
  ? registerPrintReference(
      Astro.locals.printReferences,
      href,
      formatInternalLinkLabel(paper, section, heading),
    )
  : undefined;
---

<a
  href={href}
  class:list={[
    // group
    'group',
    // layout
    variant === 'inline' && 'inline',
    variant === 'heading' && 'inline',
    variant === 'plain' && 'inline',
    // typography
    variant === 'inline' && 'text-white',
    variant === 'heading' && ['text-white', 'no-underline', 'hover:text-zinc-200'],
    // print — typography
    variant === 'inline' && 'print:text-zinc-950 print:underline',
    variant === 'heading' && 'print:text-zinc-950 print:no-underline',
    variant === 'plain' && 'print:text-zinc-950',
    className,
  ]}
>
  {
    variant === 'heading' ? (
      <>
        <span
          class:list={[
            // layout
            'mr-1',
            // typography
            'text-zinc-600 group-hover:text-zinc-400',
          ]}
          aria-hidden="true"
        >
          &sect;
        </span>
        <slot />
      </>
    ) : (
      <span
        class:list={[
          variant === 'inline' && [
            // typography
            'underline decoration-zinc-600 underline-offset-2',
            'group-hover:decoration-white',
            // print — typography
            'print:text-zinc-950',
          ],
        ]}
      >
        {
          has_breadcrumb ? (
            <>
              {paper}
              {section && (
                <>
                  {paper && (
                    <>
                      {' » '}
                      <span aria-hidden="true">&sect;</span>{' '}
                    </>
                  )}
                  {section}
                  {heading && (
                    <>
                      {' » '}
                      <span aria-hidden="true">&sect;</span> {heading}
                    </>
                  )}
                </>
              )}
            </>
          ) : (
            <slot />
          )
        }
      </span>
    )
  }
</a>
{
  ref !== undefined && (
    <sup
      class:list={[
        // layout
        'hidden',
        // print — layout
        'print:inline',
        // print — typography
        'print:text-xs print:font-normal print:text-zinc-600',
      ]}
    >
      <a
        href={`#ref-${ref}`}
        class:list={[
          // typography
          'no-underline',
          // print — typography
          'print:text-zinc-600',
        ]}
      >
        [{ref}]
      </a>
    </sup>
  )
}
