---
type Variant = 'inline' | 'heading' | 'plain';

interface Props {
  href: string;
  variant?: Variant;
  class?: string;
  /** Document title for breadcrumb labels, e.g. "Social Paper". */
  paper?: string;
  /** Part / H2 title. */
  section?: string;
  /** H3 title; omit when linking to a part only. */
  heading?: string;
}

const { href, variant = 'inline', class: className, paper, section, heading } =
  Astro.props;

const has_breadcrumb = Boolean(paper || section);
---

<a
  href={href}
  class:list={[
    'group',
    variant === 'inline' && 'inline text-white',
    variant === 'heading' && [
      'inline',
      'text-white',
      'no-underline',
      'hover:text-zinc-200',
    ],
    variant === 'plain' && 'inline',
    className,
  ]}
>
  {
    variant === 'heading' ? (
      <>
        <span
          class="mr-1 text-zinc-600 group-hover:text-zinc-400"
          aria-hidden="true">&sect;</span
        ><slot />
      </>
    ) : (
      <span
        class:list={[
          variant === 'inline' &&
            'underline decoration-zinc-600 underline-offset-2 group-hover:decoration-white',
        ]}
      >
        {
          has_breadcrumb ? (
            <>
              {paper}
              {section && (
                <>
                  {paper && (
                    <>
                      {' » '}
                      <span aria-hidden="true">&sect;</span>{' '}
                    </>
                  )}
                  {section}
                  {heading && (
                    <>
                      {' » '}
                      <span aria-hidden="true">&sect;</span> {heading}
                    </>
                  )}
                </>
              )}
            </>
          ) : (
            <slot />
          )
        }
      </span>
    )
  }
</a>
