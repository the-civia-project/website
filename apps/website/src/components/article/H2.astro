---
import InternalLink from './InternalLink.astro';
import Label from './Label.astro';

interface Props {
  id: string;
  /** Optional section label shown above the heading, e.g. "Part I". */
  part?: string;
}

const { id, part } = Astro.props;
---

<h2
  class="scroll-mt-8 mt-16 border-t border-zinc-800 pt-10 text-2xl font-bold leading-snug"
  id={id}
>
  {part && <Label class="mb-2 block font-normal">{part}</Label>}
  <InternalLink href={`#${id}`} variant="heading"><slot /></InternalLink>
</h2>
