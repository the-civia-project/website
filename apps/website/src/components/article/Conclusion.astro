---
import Label from './Label.astro';

type Props = {
  title: string;
  id: string;
  printCenterPage?: boolean;
} & ({ number: number; final?: never } | { final: true; number?: never });

const { title, id, printCenterPage = false, ...variant } = Astro.props as Props;
const is_final = 'final' in variant;
const number = 'number' in variant ? variant.number : undefined;

const label_classes = [
  // layout
  'mb-2',
  // print — layout
  'print:mb-3',
  // print — typography
  'print:font-medium',
];
---

<div
  class:list={[
    printCenterPage && [
      // print — page breaks
      'print:break-before-page',
      // print — layout
      'print:flex print:min-h-[100vh] print:flex-col',
      'print:items-start print:justify-center',
    ],
  ]}
>
  <aside
    id={id}
    class:list={[
      // layout
      'mt-10 scroll-mt-8 rounded-sm p-6',
      // border and background
      'border-l-16 p-r-15',
      is_final
        ? 'border border-zinc-300 bg-white ring-1 ring-zinc-950/10 dark:border-zinc-600 dark:bg-black dark:ring-white/10'
        : 'border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-black',
      // print — layout
      'print:mt-10 print:rounded-none print:p-0',
      is_final && 'print:mt-12 print:py-8',
      !is_final && 'print:pl-6',
      // print — border and background
      'print:bg-transparent print:ring-0',
      is_final
        ? 'print:border-0 print:border-t print:border-b print:border-zinc-200 dark:print:border-zinc-900'
        : 'print:border-0 print:border-l-4 print:border-l-zinc-950 dark:print:border-l-zinc-500',
      // print — page breaks
      'print:break-inside-avoid',
    ]}
  >
    <div
      class:list={[
        // layout
        'flex items-start gap-5',
      ]}
    >
      <div
        class:list={[
          // layout
          'min-w-0 flex-1',
        ]}
      >
        <header>
          {
            !is_final && number !== undefined && (
              <Label class:list={label_classes}>
                Conclusion {number}
              </Label>
            )
          }
          {is_final && <Label class:list={label_classes}>Closing</Label>}
          <h3
            class:list={[
              // typography
              'font-semibold text-zinc-950 dark:text-white',
              is_final ? 'text-xl' : 'text-lg',
              // print — typography
              'print:text-2xl print:font-bold',
            ]}
          >
            {title}
          </h3>
        </header>
        <div
          class:list={[
            // layout
            'mt-4 flex flex-col gap-4',
            // typography — descendants
            '[&_p]:leading-relaxed [&_p]:text-zinc-700 dark:[&_p]:text-zinc-300',
            '[&_strong]:font-semibold [&_strong]:text-zinc-950 dark:[&_strong]:text-white',
            is_final &&
              '[&_p:last-child]:text-zinc-950 dark:[&_p:last-child]:text-white',
            // print — layout
            'print:mt-4 print:gap-4',
            is_final &&
              'print:[&_p:last-child]:font-medium',
          ]}
        >
          <slot />
        </div>
      </div>
    </div>
  </aside>
</div>
