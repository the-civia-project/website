---
import { Image } from 'astro:assets';
import HeroPhoto from '../../assets/Edwin_Andrade.unsplash.webp';
import { defaultPrintBackPageCta } from '../../lib/ctas';
import PrintBranding from './PrintBranding.astro';
import PrintCommunityLinks from './PrintCommunityLinks.astro';

const { title, description } = defaultPrintBackPageCta;
---

<div
  class:list={[
    'print-back-page',
    // display
    'hidden',
    // print — layout
    'print:flex print:min-h-[100vh] print:flex-col',
    'print:items-start print:justify-center',
    // print — page breaks
    'print:break-before-page print:break-inside-avoid',
  ]}
>
  <PrintBranding />

  <Image
    src={HeroPhoto}
    alt="Many hands raised toward the sky"
    class:list={[
      // print — layout
      'print:mt-6 print:w-full print:aspect-[16/9] print:object-cover print:object-bottom',
      // print — border
      'print:rounded-2xl',
      // print — color
      'print:print-color-adjust-exact',
    ]}
  />

  <h2
    data-print-back-title
    class:list={[
      // print — layout
      'print:mt-8',
      // print — typography
      'print:text-3xl print:font-bold print:tracking-tight print:text-zinc-950',
    ]}
  >
    {title}
  </h2>

  <p
    data-print-back-description
    class:list={[
      // print — layout
      'print:mt-4 print:max-w-prose',
      // print — typography
      'print:text-base print:leading-relaxed print:text-zinc-600',
    ]}
  >
    {description}
  </p>

  <div
    class:list={[
      // print — layout
      'print:mt-8',
    ]}
  >
    <PrintCommunityLinks />
  </div>
</div>

<script>
  import { printBackPageCtas } from '../../lib/ctas';

  // SSR always renders defaultPrintBackPageCta for stable cached HTML.
  // Swap to a random preset in the browser before the user prints.
  // Applies a random CTA (Call To Action) from printBackPageCtas
  // to the "Back Page" print view. Ensures each print gets a different message.
  (function updatePrintBackPageCta() {
    // Find the root element for the print back page
    const root = document.querySelector('.print-back-page');

    // If not found, or not an HTMLElement, exit early
    if (!(root instanceof HTMLElement)) return;

    // Pick a random CTA preset from the available list
    const cta =
      printBackPageCtas[Math.floor(Math.random() * printBackPageCtas.length)]!;

    // Find title and description elements by specific data attributes
    const titleEl = root.querySelector('[data-print-back-title]');
    const descriptionEl = root.querySelector('[data-print-back-description]');

    // Set the text content of each, if present
    if (titleEl) {
      titleEl.textContent = cta.title;
    }

    if (descriptionEl) {
      descriptionEl.textContent = cta.description;
    }
  })();
</script>
