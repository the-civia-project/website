---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure
  class:list={[
    // layout
    'mt-8 px-4 py-6',
    // border and background
    'rounded-sm border border-zinc-800 bg-zinc-950',
    // print — border and background
    'print:border-zinc-300 print:bg-white print:print-color-adjust-exact',
    // print — page breaks
    'print:break-inside-avoid',
  ]}
>
  <div
    class:list={[
      // layout
      'overflow-x-auto',
      // typography
      'text-zinc-400',
      // print — typography
      'print:text-zinc-600 print:print-color-adjust-exact',
    ]}
  >
    <slot />
  </div>
  <figcaption
    class:list={[
      // layout
      'mt-3 text-center',
      // typography
      'text-xs text-zinc-500',
      // print — typography
      'print:text-zinc-500',
    ]}
  >
    {caption}
  </figcaption>
</figure>
