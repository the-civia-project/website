---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="mt-8 rounded-sm border border-zinc-800 bg-zinc-950 px-4 py-6 print:border-zinc-300 print:bg-white">
  <div class="overflow-x-auto text-zinc-400 print:text-zinc-600">
    <slot />
  </div>
  <figcaption class="mt-3 text-center text-xs text-zinc-500">
    {caption}
  </figcaption>
</figure>
