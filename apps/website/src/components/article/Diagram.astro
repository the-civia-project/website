---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure
  class:list={[
    // layout
    'mt-8 px-4 py-6',
    // border and background
    'rounded-sm border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-black',
    // print — page breaks
    'print:break-inside-avoid',
  ]}
>
  <div
    class:list={[
      // layout
      'overflow-x-auto',
      // typography
      'text-zinc-600 dark:text-zinc-400',
    ]}
  >
    <slot />
  </div>
  <figcaption
    class:list={[
      // layout
      'mt-3 text-center',
      // typography
      'text-xs text-zinc-500 dark:text-zinc-400',
    ]}
  >
    {caption}
  </figcaption>
</figure>
