---
import PrinterIcon from '../../assets/icons/printer.svg';
---

<button
  type="button"
  onclick="window.print()"
  aria-label="Print or save as PDF"
  class="print:hidden shrink-0 rounded-sm p-2 text-zinc-400 transition-colors hover:text-white focus:text-white cursor-pointer"
>
  <PrinterIcon class="size-5 fill-current" />
</button>
