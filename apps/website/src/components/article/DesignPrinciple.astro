---
import Label from './Label.astro';

interface Props {
  id: string;
  title: string;
  final?: boolean;
}

const { id, title, final = false } = Astro.props;
const label = final ? 'Final Principle' : 'Design Principle';
---

<aside
  id={id}
  class:list={[
    // layout
    'mt-10 scroll-mt-8 py-1 pl-6',
    // border
    'border-l-2',
    final
      ? 'border-zinc-950/80 ring-1 ring-zinc-950/10 dark:border-white/80 dark:ring-white/10'
      : 'border-zinc-400 dark:border-zinc-500',
    // print — layout
    'print:py-2',
    // print — border and background
    'border-l-2 print:bg-transparent print:ring-0',
    final
      ? 'print:border-0 print:border-l-4 print:border-l-zinc-950 dark:print:border-l-white'
      : 'print:border-0 print:border-l-4 print:border-l-zinc-400 dark:print:border-l-zinc-500',
    // print — page breaks
    'print:break-inside-avoid',
  ]}
>
  <Label>{label}</Label>
  <h3
    class:list={[
      // layout
      'mt-2',
      // typography
      'text-lg font-semibold text-zinc-950 dark:text-white',
      // print — typography
      'print:text-2xl print:font-semibold',
    ]}
  >
    {title}
  </h3>
  <div
    class:list={[
      // layout
      'mt-4 space-y-4',
      // typography — descendants
      '[&_p]:leading-relaxed [&_p]:text-zinc-700 dark:[&_p]:text-zinc-300',
      '[&_strong]:font-semibold [&_strong]:text-zinc-950 dark:[&_strong]:text-white',
      final &&
        '[&_p:last-child]:text-zinc-800 dark:[&_p:last-child]:text-zinc-100',
    ]}
  >
    <slot />
  </div>
</aside>
