---
import InternalLink from './InternalLink.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<h3 class="scroll-mt-8 mt-8 text-lg font-semibold text-zinc-100" id={id}>
  <InternalLink href={`#${id}`} variant="heading" class="text-zinc-100">
    <slot />
  </InternalLink>
</h3>
