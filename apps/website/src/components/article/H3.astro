---
import InternalLink from './InternalLink.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<h3
  class:list={[
    // layout
    'scroll-mt-8 mt-8',
    // typography
    'text-lg font-semibold text-zinc-100',
    // print — typography
    'print:text-zinc-950',
    // print — page breaks
    'print:break-inside-avoid print:break-after-avoid-page',
  ]}
  id={id}
>
  <InternalLink
    href={`#${id}`}
    variant="heading"
    class:list={[
      // typography
      'text-zinc-100',
      // print — typography
      'print:text-zinc-950 print:no-underline',
      // print — descendants
      'print:[&>span[aria-hidden]]:hidden',
    ]}
  >
    <slot />
  </InternalLink>
</h3>
