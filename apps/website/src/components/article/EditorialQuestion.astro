---
import QuestionIcon from '../../assets/icons/question.svg';

// Temporary internal marker; remove when resolved.
---

<div
  data-editorial-question
  class:list={[
    // layout
    'mt-4 px-4 py-3',
    // border and background
    'rounded border border-yellow-600/40 bg-yellow-500/10 dark:border-yellow-500/40',
    // typography
    'text-yellow-900 dark:text-yellow-200',
    // print — display
    'print:hidden',
  ]}
>
  <div
    class:list={[
      // layout
      'flex items-start gap-2',
      // typography
      'text-sm text-yellow-900 dark:text-yellow-200',
    ]}
  >
    <QuestionIcon
      class:list={[
        // layout
        'mt-0.5 size-5 shrink-0',
        // color
        'fill-current text-yellow-900 dark:text-yellow-200',
      ]}
      aria-hidden="true"
    />
    <div
      class:list={[
        // layout
        'min-w-0 flex-1',
        // typography
        'text-yellow-900 dark:text-yellow-200',
      ]}
    >
      <slot />
    </div>
  </div>
</div>
