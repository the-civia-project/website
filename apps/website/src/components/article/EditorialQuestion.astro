---
import QuestionIcon from '../../assets/icons/question.svg';

// Temporary internal marker; remove when resolved.
---

<div
  data-editorial-question
  class="mt-4 rounded border border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-yellow-200"
>
  <div class="flex items-start gap-2 text-sm text-yellow-200">
    <QuestionIcon
      class="mt-0.5 size-5 shrink-0 fill-current text-yellow-200"
      aria-hidden="true"
    />
    <div class="min-w-0 flex-1 text-yellow-200">
      <slot />
    </div>
  </div>
</div>
