---
import Label from './Label.astro';

export interface TocItem {
  id: string;
  part: string;
  title: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<section
  class:list={[
    // print — page breaks
    'print:break-before-page',
  ]}
>
  <div
    class:list={[
      // print — layout
      'print:flex print:min-h-[100vh] print:flex-col',
      'print:items-start print:justify-center',
      // print — page breaks
      'print:break-inside-avoid',
    ]}
  >
    <nav
      aria-label="Table of contents"
      class:list={[
        // layout
        'mt-10 p-6',
        // border and background
        'rounded-sm border border-zinc-800 bg-zinc-950',
        // print — layout
        'print:mt-0 print:p-0',
        // print — border and background
        'print:border-0 print:bg-transparent',
      ]}
    >
      <Label
        class:list={[
          // print — layout
          'print:mb-10',
          // print — typography
          'print:text-2xl print:font-bold print:normal-case print:tracking-tight',
          'print:text-zinc-900',
        ]}
      >
        Contents
      </Label>
      <ol
        class:list={[
          // layout
          'mt-4 space-y-2',
          // typography
          'text-sm',
          // print — layout
          'print:mt-0 print:space-y-0',
          // print — typography
          'print:text-base',
        ]}
      >
        {
          items.map(({ id, part, title }) => (
            <li
              class:list={[
                // print — layout
                'print:py-4',
                // print — border
                'print:border-b print:border-zinc-200',
                'print:last:border-b-0',
              ]}
            >
              <a
                href={`#${id}`}
                class:list={[
                  // typography
                  'text-zinc-400',
                  // interactive
                  'transition-colors hover:text-white',
                  // print — layout
                  'print:block',
                  // print — typography
                  'print:text-inherit print:no-underline',
                ]}
              >
                <span
                  class:list={[
                    // typography
                    'text-zinc-600',
                    // print — layout
                    'print:block',
                    // print — typography
                    'print:text-xs print:font-medium print:uppercase print:tracking-widest',
                    'print:text-zinc-500',
                  ]}
                >
                  {part}
                </span>
                <span
                  class:list={[
                    // print — display
                    'print:hidden',
                  ]}
                >
                  {' '}
                  &mdash;{' '}
                </span>
                <span
                  class:list={[
                    // print — layout
                    'print:mt-1.5 print:block',
                    // print — typography
                    'print:text-base print:font-medium print:leading-snug',
                    'print:text-zinc-900',
                  ]}
                >
                  {title}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>
