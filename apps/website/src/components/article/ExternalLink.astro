---
import ArrowSquareOutIcon from '../../assets/icons/arrow-square-out.svg';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    // group
    'group',
    // layout
    'inline inline-flex items-baseline gap-1',
    // typography
    'text-white',
    // print — typography
    'print:text-zinc-950 print:underline',
    className,
  ]}
>
  <span
    class:list={[
      // typography
      'underline decoration-zinc-600 underline-offset-2',
      // interactive
      'group-hover:decoration-white',
    ]}
  >
    <slot />
  </span>
  <ArrowSquareOutIcon
    class:list={[
      // layout
      'inline-block shrink-0 align-text-bottom',
      // sizing
      'size-4',
      // color
      'fill-current opacity-50',
      // interactive
      'transition-opacity group-hover:opacity-100',
      // print — display
      'print:hidden',
    ]}
    aria-hidden="true"
  />
</a>
