---
import { renderMermaidThemes } from '../../lib/render-mermaid';

interface Props {
  caption: string;
  chart: string;
}

const { caption, chart } = Astro.props;
const { light, dark } = await renderMermaidThemes(chart);
---

<figure
  class:list={[
    // layout
    'mt-8 px-4 py-6',
    // border and background
    'rounded-sm border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-black',
    // print — page breaks
    'print:break-inside-avoid',
  ]}
>
  <div class="mermaid-diagram overflow-x-auto">
    <div class="mermaid-theme-light" set:html={light} />
    <div class="mermaid-theme-dark" set:html={dark} />
  </div>
  <figcaption
    class:list={[
      // layout
      'mt-3 text-center',
      // typography
      'text-xs text-zinc-500 dark:text-zinc-400',
    ]}
  >
    {caption}
  </figcaption>
</figure>
