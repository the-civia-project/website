---
import CheckCircleIcon from '../../assets/icons/check-circle.svg';

// Temporary internal marker; remove when resolved.
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  data-editorial-todo
  class="mt-4 rounded border border-teal-500/40 bg-teal-500/10 px-4 py-3 text-teal-200 [&_*]:!text-teal-200"
>
  <div class="flex items-center gap-2 leading-none">
    <CheckCircleIcon
      class="size-5 shrink-0 fill-current text-teal-200"
      aria-hidden="true"
    />
    <span class="font-medium">{title}</span>
  </div>
  <div class="mt-3 space-y-3 text-sm">
    <slot />
  </div>
</div>
