---
import { format } from 'date-fns';
import DiscordIcon from '../../assets/social/discord.svg';
import MatrixIcon from '../../assets/social/matrix.svg';
import GlobeIcon from '../../assets/icons/globa.svg';
import RocketIcon from '../../assets/icons/rocket-launch.svg';
import Logo from '../Logo.astro';
import Label from './Label.astro';
import PrintPdfButton from './PrintPdfButton.astro';

interface Props {
  label?: string;
  title: string;
  authors: string[];
  date: Date | string;
  draft?: boolean;
  printCover?: boolean;
  printDescription?: string;
}

const {
  label,
  title,
  authors,
  date,
  draft = false,
  printCover = false,
  printDescription,
} = Astro.props;
const authorLine = authors.join(', ');
const published = format(new Date(date), 'dd/MM/yyyy');

const communityLinks = [
  {
    href: 'https://theciviaproject.org',
    label: 'theciviaproject.org',
    Icon: GlobeIcon,
  },
  {
    href: 'https://demo.theciviaproject.org',
    label: 'demo.theciviaproject.org',
    Icon: RocketIcon,
  },
  {
    href: 'https://discord.gg/pNTmzvd7pe',
    label: 'discord.gg/pNTmzvd7pe',
    Icon: DiscordIcon,
  },
  {
    href: 'https://matrix.to/#/#the-civia-project:matrix.org',
    label: '#the-civia-project:matrix.org',
    Icon: MatrixIcon,
  },
];
---

<header
  class:list={[
    printCover && [
      // print — layout
      'print:flex print:min-h-[100vh] print:flex-col',
      'print:items-start print:justify-center',
      // print — page breaks
      'print:break-inside-avoid print:break-after-page',
    ],
  ]}
>
  {
    printCover && (
      <div
        class:list={[
          // display
          'hidden print:flex',
          // print — layout
          'print:mb-5 print:items-center print:gap-4',
        ]}
      >
        <Logo />
        <div>
          <p
            class:list={[
              // print — typography
              'print:text-2xl print:font-bold print:text-zinc-950',
            ]}
          >
            The Civia Project
          </p>
          <p
            class:list={[
              // print — typography
              'print:text-xs print:italic print:text-zinc-500',
            ]}
          >
            Real People. Real Talk.
          </p>
        </div>
      </div>
    )
  }
  <div
    class:list={[
      // layout
      'flex items-start justify-between gap-4',
    ]}
  >
    <div
      class:list={[
        // layout
        'min-w-0 flex-1',
      ]}
    >
      {
        label && (
          <Label class:list={[printCover && 'print:hidden']}>{label}</Label>
        )
      }
      <h1
        class:list={[
          // layout
          'mt-2',
          printCover && 'print:mt-0',
          // typography
          'text-4xl font-bold tracking-tight md:text-5xl',
          // print — typography
          'print:text-7xl print:leading-tight print:text-zinc-950',
        ]}
      >
        {title}
      </h1>
    </div>

    <div
      class:list={[
        // layout
        'flex shrink-0 items-center gap-3',
        // print — display
        'print:hidden',
      ]}
    >
      {
        draft && (
          <span
            class:list={[
              // display
              'print:hidden',
              // layout
              'px-2.5 pt-1 pb-0.5',
              // border and background
              'rounded-full border border-amber-500/40 bg-amber-500/15',
              // typography
              'text-xs font-medium uppercase tracking-wide text-amber-200',
            ]}
          >
            Draft
          </span>
        )
      }
      <PrintPdfButton />
    </div>
  </div>
  {
    printDescription && (
      <p
        class:list={[
          // display
          'hidden print:block',
          // print — layout
          'print:mt-6 print:max-w-prose',
          // print — typography
          'print:text-base print:leading-relaxed print:text-zinc-600',
        ]}
      >
        {printDescription}
      </p>
    )
  }
  <p
    class:list={[
      // layout
      'mt-4',
      // typography
      'text-sm text-zinc-300',
      // print — typography
      'print:text-zinc-700',
    ]}
  >
    <span
      class:list={[
        // typography
        'text-zinc-500',
        // print — typography
        'print:text-zinc-500',
      ]}
    >
      By
    </span>
    {authorLine}
    <span
      class:list={[
        // typography
        'text-zinc-600',
        // print — typography
        'print:text-zinc-500',
        printCover && 'print:hidden',
      ]}
    >
      {' '}·{' '}
    </span>
    <span class:list={[printCover && 'print:hidden']}>{published}</span>
  </p>
  {
    printCover && (
      <div
        class:list={[
          // display
          'hidden print:flex',
          // print — layout
          'print:mt-8 print:items-center print:gap-4',
        ]}
      >
        <img
          src="/qr.svg"
          alt=""
          class:list={[
            // print — layout
            'print:size-32 print:shrink-0',
          ]}
        />
        <div
          class:list={[
            // print — layout
            'print:flex print:flex-col print:gap-3',
          ]}
        >
          {communityLinks.map(({ href, label, Icon }) => (
            <a
              href={href}
              class:list={[
                // print — layout
                'print:flex print:items-center print:gap-2',
                // print — typography
                'print:text-sm print:text-zinc-600 print:no-underline',
              ]}
            >
              <Icon
                width={16}
                height={16}
                class:list={[
                  // print — layout
                  'print:shrink-0',
                  // print — fill
                  'print:fill-zinc-600',
                ]}
              />
              {label}
            </a>
          ))}
        </div>
      </div>
    )
  }
</header>
