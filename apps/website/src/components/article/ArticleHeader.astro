---
import { format } from 'date-fns';
import Label from './Label.astro';
import PrintPdfButton from './PrintPdfButton.astro';

interface Props {
  label?: string;
  title: string;
  authors: string[];
  date: Date | string;
}

const { label, title, authors, date } = Astro.props;
const authorLine = authors.join(', ');
const published = format(new Date(date), 'dd/MM/yyyy');
---

<header>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      {label && <Label>{label}</Label>}
      <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
        {title}
      </h1>
    </div>

    <PrintPdfButton />
  </div>
  <p class="mt-4 text-sm text-zinc-300">
    <span class="text-zinc-500">By</span>
    {authorLine}
    <span class="text-zinc-600"> · </span>
    {published}
  </p>
</header>
