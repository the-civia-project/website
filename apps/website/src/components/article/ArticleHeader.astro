---
import { format } from 'date-fns';
import Label from './Label.astro';
import PrintPdfButton from './PrintPdfButton.astro';

interface Props {
  label?: string;
  title: string;
  authors: string[];
  date: Date | string;
  draft?: boolean;
}

const { label, title, authors, date, draft = false } = Astro.props;
const authorLine = authors.join(', ');
const published = format(new Date(date), 'dd/MM/yyyy');
---

<header>
  <div
    class:list={[
      // layout
      'flex items-start justify-between gap-4',
    ]}
  >
    <div
      class:list={[
        // layout
        'min-w-0 flex-1',
      ]}
    >
      {label && <Label>{label}</Label>}
      <h1
        class:list={[
          // layout
          'mt-2',
          // typography
          'text-4xl font-bold tracking-tight md:text-5xl',
          // print — typography
          'print:text-zinc-950',
        ]}
      >
        {title}
      </h1>
    </div>

    <div
      class:list={[
        // layout
        'flex shrink-0 items-center gap-3',
      ]}
    >
      {
        draft && (
          <span
            class:list={[
              // display
              'print:hidden',
              // layout
              'px-2.5 pt-1 pb-0.5',
              // border and background
              'rounded-full border border-amber-500/40 bg-amber-500/15',
              // typography
              'text-xs font-medium uppercase tracking-wide text-amber-200',
            ]}
          >
            Draft
          </span>
        )
      }
      <PrintPdfButton />
    </div>
  </div>
  <p
    class:list={[
      // layout
      'mt-4',
      // typography
      'text-sm text-zinc-300',
      // print — typography
      'print:text-zinc-700',
    ]}
  >
    <span
      class:list={[
        // typography
        'text-zinc-500',
        // print — typography
        'print:text-zinc-500',
      ]}
    >
      By
    </span>
    {authorLine}
    <span
      class:list={[
        // typography
        'text-zinc-600',
        // print — typography
        'print:text-zinc-500',
      ]}
    >
      {' '}·{' '}
    </span>
    {published}
  </p>
</header>
