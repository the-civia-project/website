---
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  markerId: string;
}

const { x1, y1, x2, y2, markerId } = Astro.props;
const marker = `url(#${markerId})`;
---

<line
  class="diagram-arrow"
  x1={x1}
  y1={y1}
  x2={x2}
  y2={y2}
  stroke-width="1.5"
  marker-end={marker}></line>
