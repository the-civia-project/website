---
import ArrowDefs from './ArrowDefs.astro';
import DiagramArrow from './DiagramArrow.astro';
import DiagramNode from './DiagramNode.astro';
import {
  ARROW_GAP,
  NODE_H,
  P,
  W,
  nodeRowY,
  nodeCenterY,
} from './diagram-tokens';

const arrow = 'identity-arrow';
const y = nodeRowY(P);
const cy = nodeCenterY(P);

const nodes = [
  { w: 130, title: 'EUDI Wallet', subtitle: 'credential' },
  { w: 150, title: 'Selective disclosure', subtitle: '/ ZKP' },
  { w: 130, title: 'Verified', subtitle: 'account' },
  { w: 174, title: 'Pseudonym separation', subtitle: 'on-platform handle' },
];

const totalW =
  nodes.reduce((sum, n) => sum + n.w, 0) + ARROW_GAP * (nodes.length - 1);
let x = (W - totalW) / 2;

const positioned = nodes.map((node) => {
  const pos = { ...node, x };
  x += node.w + ARROW_GAP;
  return pos;
});

const viewH = P + NODE_H + P;
---

<svg
  viewBox={`0 0 ${W} ${viewH}`}
  width="100%"
  height="auto"
  role="img"
  aria-label="Identity verification flow from EUDI Wallet to pseudonym separation"
  xmlns="http://www.w3.org/2000/svg"
>
  <ArrowDefs id={arrow} />
  {
    positioned.map((node, i) => (
      <>
        {i > 0 && (
          <DiagramArrow
            x1={positioned[i - 1].x + positioned[i - 1].w}
            y1={cy}
            x2={node.x}
            y2={cy}
            markerId={arrow}
          />
        )}
        <DiagramNode
          x={node.x}
          y={y}
          width={node.w}
          title={node.title}
          subtitle={node.subtitle}
        />
      </>
    ))
  }
</svg>
