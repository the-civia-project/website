---
import { FONT_CAPTION, ZONE_INSET } from './diagram-tokens';

interface Props {
  x: number;
  y: number;
  text: string;
  anchor?: 'start' | 'middle';
  width?: number;
}

const { x, y, text, anchor = 'start', width } = Astro.props;
const textX = anchor === 'middle' && width !== undefined ? x + width / 2 : x + ZONE_INSET;
---

<text
  class="diagram-label"
  x={textX}
  y={y}
  text-anchor={anchor === 'middle' ? 'middle' : 'start'}
  font-size={FONT_CAPTION}>{text}</text
>
