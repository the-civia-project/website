---
import ArrowDefs from './ArrowDefs.astro';
import DiagramArrow from './DiagramArrow.astro';
import DiagramNode from './DiagramNode.astro';
import DiagramZone from './DiagramZone.astro';
import {
  ARROW_GAP,
  NODE_H,
  P,
  W,
  ZONE_INSET,
  nodeCenterY,
  nodeRowY,
  zoneHeight,
} from './diagram-tokens';

const arrow = 'feed-arrow';
const zoneX = P;
const zoneY = P;
const zoneW = W - P * 2;
const zoneH = zoneHeight(NODE_H, false);
const rowY = nodeRowY(zoneY);
const cy = nodeCenterY(zoneY);

const steps = [
  { title: '1. Intent', subtitle: 'on device' },
  { title: '2. Send', subtitle: 'intent' },
  { title: '3. Query', subtitle: 'vector DB' },
  { title: '4. Probabilistic', subtitle: 'filters' },
  { title: '5. Ranking', subtitle: 'model' },
  { title: '6. Feed', subtitle: 'returned' },
];

const innerW = zoneW - ZONE_INSET * 2;
const nodeW = (innerW - ARROW_GAP * (steps.length - 1)) / steps.length;
const startX = zoneX + ZONE_INSET;

const viewH = P + zoneH + P;
---

<svg
  viewBox={`0 0 ${W} ${viewH}`}
  width="100%"
  height="auto"
  role="img"
  aria-label="Public feed pipeline: intent, vector query, filters, ranking, feed"
  xmlns="http://www.w3.org/2000/svg"
>
  <ArrowDefs id={arrow} />
  <DiagramZone
    x={zoneX}
    y={zoneY}
    width={zoneW}
    height={zoneH}
    label="Public feed pipeline"
    labelAnchor="middle"
  />
  {
    steps.map((step, i) => {
      const x = startX + i * (nodeW + ARROW_GAP);
      return (
        <>
          {i > 0 && (
            <DiagramArrow
              x1={startX + (i - 1) * (nodeW + ARROW_GAP) + nodeW}
              y1={cy}
              x2={x}
              y2={cy}
              markerId={arrow}
            />
          )}
          <DiagramNode
            x={x}
            y={rowY}
            width={nodeW}
            title={step.title}
            subtitle={step.subtitle}
          />
        </>
      );
    })
  }
</svg>
