---
import { FONT_NODE, FONT_SUB, NODE_H, NODE_RX } from './diagram-tokens';

interface Props {
  x: number;
  y: number;
  width: number;
  title: string;
  subtitle?: string;
  height?: number;
  rx?: number;
  fontSize?: number;
  subFontSize?: number;
}

const {
  x,
  y,
  width,
  title,
  subtitle,
  height = NODE_H,
  rx = NODE_RX,
  fontSize = FONT_NODE,
  subFontSize = FONT_SUB,
} = Astro.props;

const cx = x + width / 2;
const titleY = subtitle ? y + height * 0.42 : y + height * 0.58;
const subtitleY = y + height * 0.72;
---

<rect
  class="diagram-node"
  x={x}
  y={y}
  width={width}
  height={height}
  rx={rx}
  ry={rx}
  stroke-width="1.5"></rect>
<text
  class="diagram-text"
  x={cx}
  y={titleY}
  text-anchor="middle"
  font-size={fontSize}>{title}</text
>
{
  subtitle && (
    <text
      class="diagram-subtext"
      x={cx}
      y={subtitleY}
      text-anchor="middle"
      font-size={subFontSize}
    >
      {subtitle}
    </text>
  )
}
