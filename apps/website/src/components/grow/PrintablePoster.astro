---
interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;

const mission =
  'Make the world more resilient towards and better equipped against fake news, propaganda, disinformation, misinformation and malinformation.';
const url = 'https://theciviaproject.org';
---

<div class:list={['grow-printable grow-print-poster', !preview && 'hidden']}>
  <div
    class="flex h-[420mm] w-[297mm] flex-col items-center justify-center gap-12 bg-white p-16 text-center text-black"
  >
    <img src="/grow/logo.svg" alt="" width="160" height="190" class="h-44 w-auto" />

    <div>
      <h1 class="text-7xl font-bold tracking-tight">The Civia Project</h1>
      <p class="mt-4 text-3xl italic text-zinc-600">Real People. Real Talk.</p>
    </div>

    <p class="max-w-2xl text-2xl leading-relaxed text-zinc-700">{mission}</p>

    <div class="flex flex-col items-center gap-6">
      <img src="/grow/qr-code.svg" alt="" width="200" height="200" class="size-48" />
      <p class="text-3xl font-semibold tracking-wide">{url}</p>
    </div>
  </div>
</div>
