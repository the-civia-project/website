---
interface Props {
  src: string;
  target: string;
}

const { src, target } = Astro.props;
---

<div class:list={['grow-printable', `grow-print-${target}`, 'hidden']}>
  <img
    src={src}
    alt=""
    width="210"
    height="297"
    class="block h-[297mm] w-[210mm] object-contain"
  />
</div>
