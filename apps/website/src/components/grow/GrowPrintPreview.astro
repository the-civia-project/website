---
interface Props {
  src: string;
  alt: string;
  /** Width/height ratio, e.g. "210/297" for A4 */
  aspect?: `${number}/${number}`;
  width?: number;
  height?: number;
}

const { src, alt, aspect = '210/297', width = 210, height = 297 } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  class="mx-auto block w-full max-w-full bg-white object-contain"
  style={`aspect-ratio: ${aspect}`}
/>
