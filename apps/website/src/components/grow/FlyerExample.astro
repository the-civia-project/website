---
import GrowDownloadLink from './GrowDownloadLink.astro';
import ResourceCard from './ResourceCard.astro';
import type { FlyerExampleData } from './FlyerExampleList.astro';

type Props = FlyerExampleData;

const { title, description, href, download } = Astro.props;
---

<ResourceCard {title} {description}>
  <div slot="actions">
    <GrowDownloadLink href={href} download={download}>Download PDF</GrowDownloadLink>
  </div>
</ResourceCard>
