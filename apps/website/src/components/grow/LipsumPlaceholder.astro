---
interface Props {
  label: string;
  format?: string;
  /** Width/height ratio, e.g. "210/297" for A4 */
  aspect?: `${number}/${number}`;
}

const { label, format = 'A4 · 210 × 297 mm', aspect = '210/297' } = Astro.props;
---

<div
  class="mx-auto w-full max-w-full bg-white"
  style={`aspect-ratio: ${aspect}`}
>
  <div
    class="relative flex h-full flex-col border border-dashed border-zinc-300 p-[8%]"
  >
    <div class="flex flex-1 flex-col gap-[3%]">
      <div class="h-[3.5%] w-[55%] rounded-sm bg-zinc-300"></div>
      <div class="h-[2.5%] w-[80%] rounded-sm bg-zinc-200"></div>
      <div class="h-[2.5%] w-[70%] rounded-sm bg-zinc-200"></div>
      <div class="mt-[4%] h-[2.5%] w-[90%] rounded-sm bg-zinc-100"></div>
      <div class="h-[2.5%] w-[85%] rounded-sm bg-zinc-100"></div>
      <div class="h-[2.5%] w-[75%] rounded-sm bg-zinc-100"></div>
      <div class="h-[2.5%] w-[60%] rounded-sm bg-zinc-100"></div>
      <div class="mt-auto flex justify-center pt-[6%]">
        <div class="aspect-square w-[22%] rounded-sm border border-dashed border-zinc-300 bg-zinc-50"></div>
      </div>
    </div>
    <div class="mt-[6%] text-center">
      <p class="text-[clamp(0.5rem,2.5vw,0.75rem)] font-semibold uppercase tracking-widest text-zinc-500">
        {label}
      </p>
      <p class="mt-1 text-[clamp(0.45rem,2vw,0.65rem)] text-zinc-400">{format}</p>
    </div>
  </div>
</div>
