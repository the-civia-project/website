---
import Image from '@the-civia-project/assets/og/about.webp';
import AlexandruIfrim from '@the-civia-project/assets/team/alexandru-ifrim.webp';
import GabrielPene from '@the-civia-project/assets/team/gabriel-pene.webp';
import TudorPalade from '@the-civia-project/assets/team/tudor-palade.webp';
import ȘtefanAlexandruMocanu from '@the-civia-project/assets/team/ștefan-alexandru-mocanu.webp';
import TeamMember from '../components/TeamMember.astro';
import U from '../components/U.astro';
import Layout from '../layouts/Layout.astro';

const image_url = new URL(Image.src, Astro.site);

const description =
  'About the The Civia Project, our reasons for creating it and the team behind it.';
---

<Layout>
  <Fragment slot="header">
    <title>Who We Are &mdash; The Civia Project</title>

    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image_url} />

    <!-- X Card -->
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image_url} />
  </Fragment>

  <header>
    <span class="block text-xs uppercase tracking-widest text-zinc-500"
      >About</span
    >
    <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
      Who We Are
    </h1>
  </header>

  <section
    class="mt-10 border-t border-zinc-800 pt-10 [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-zinc-300"
  >
    <h2 class="text-2xl font-bold leading-snug text-white">
      What is <U>The Civia Project</U>?
    </h2>

    <p>
      At its essence it is attempt to address one of the failings of capitalism
      and one ouf our failings as humans in a Post-WWII Europe in order to
      protect our valued democracies and safeguard our future.
    </p>

    <p>
      We believe, that within social capitalism at least, social media should
      not be influenced by capital needs but by the needs of its community.
    </p>

    <p>
      The main responsibility of the platform should be its users' benefits, not
      profit margins, corporate or government interests.
    </p>

    <p>
      We are working on setting up a non-profit non-governmental organization
      with a set of rules that will work as a framework meant to limit and
      empower us. To keep us on the straight and narrow.
    </p>
  </section>

  <section class="mt-10 border-t border-zinc-800 pt-10">
    <h2 class="text-2xl font-bold leading-snug text-white">Meet the Team</h2>

    <div class="mt-10 grid grid-cols-2 gap-8">
      <TeamMember
        src={AlexandruIfrim}
        name="Alexandru Ifrim"
        linkedin="https://www.linkedin.com/in/alexandruifrim/"
        description="Leader of The Civia Project and lead engineer with over a decade of full-stack experience. Helps define how Civia is governed and held accountable to the people it serves."
      />
      <TeamMember
        src={GabrielPene}
        name="Gabriel Pene"
        linkedin="https://www.linkedin.com/in/gabriel-pene/"
        description="Background in law and experience in developer relations and technical writing. Civia's lead on legal matters. Helps define how Civia is governed and held accountable to the people it serves."
      />
      <TeamMember
        src={TudorPalade}
        name="Tudor Palade"
        linkedin="https://www.linkedin.com/in/tudor-palade/"
        description="Full-stack engineer with a backend and SRE focus. Builds production systems, monitoring, and automation tooling that keep platforms reliable at scale."
      />
      <TeamMember
        src={ȘtefanAlexandruMocanu}
        name="Ștefan Alexandru Mocanu"
        linkedin="https://www.linkedin.com/in/stefan-alexandru-mocanu/"
        description="Full-stack engineer with experience in microservices, data systems, and platform architecture. Brings knowledge of social media algorithmic feeds to Civia's technical design."
      />
    </div>
  </section>
</Layout>
