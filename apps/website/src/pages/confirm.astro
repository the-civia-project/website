---
import RocketLaunch from '../assets/icons/rocket-launch.svg';
import WarningIcon from '../assets/icons/warning.svg';
import Label from '../components/article/Label.astro';
import Loading from '../components/Loading.astro';
import Strong from '../components/Strong.astro';
import U from '../components/U.astro';
import Layout from '../layouts/Layout.astro';

const description =
  'Confirm your subscription to The Civia Project newsletter.';
---

<Layout centered>
  <Fragment slot="header">
    <title>The Civia Project &mdash; Confirm</title>
    <meta name="description" content={description} />
  </Fragment>

  <Loading
    id="confirm-loading"
    title="Confirming"
    description="We're validating your email address. Hang tight."
  />

  <div id="confirm-success" class="hidden space-y-8">
    <header>
      <Label>Newsletter</Label>
      <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
        You're in
      </h1>
      <p class="mt-4 leading-relaxed text-zinc-300">
        Your email address has been <Strong>confirmed</Strong>. You will now
        receive <U>updates</U> us. Thank you!
      </p>
    </header>

    <aside
      class="border-l-2 border-zinc-700 py-1 pl-6 [&_p]:mt-3 [&_p]:italic [&_p]:leading-relaxed [&_p]:text-zinc-300"
    >
      <div class="flex items-center gap-2">
        <RocketLaunch class="w-5 shrink-0 fill-current" />
        <Label class="!mt-0">All done</Label>
      </div>
      <p>You have successfully confirmed your subscription!</p>
    </aside>
  </div>

  <div id="confirm-error" class="hidden space-y-8">
    <header>
      <Label>Newsletter</Label>
      <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
        Link expired
      </h1>
      <p class="mt-4 leading-relaxed text-zinc-300">
        This confirmation link is <Strong>invalid</Strong> or has <U
          >already been used</U
        >. <Strong>Subscribe again</Strong> from the website if you still want to
        join the newsletter.
      </p>
    </header>

    <aside
      class="border-l-2 border-zinc-700 py-1 pl-6 [&_p]:mt-3 [&_p]:italic [&_p]:leading-relaxed [&_p]:text-zinc-300"
    >
      <div class="flex items-center gap-2">
        <WarningIcon class="w-5 shrink-0 fill-current" />
        <Label class="!mt-0">Not found</Label>
      </div>
      <p>We could not confirm your subscription with this link.</p>
    </aside>
  </div>
</Layout>

<script>
  import { API_URL } from 'astro:env/client';

  const urlSearchParams = new URLSearchParams(window.location.search);
  const params = Object.fromEntries(urlSearchParams.entries());

  const loading = document.getElementById('confirm-loading');
  const success = document.getElementById('confirm-success');
  const error = document.getElementById('confirm-error');

  const show = (el: HTMLElement | null) => {
    loading?.classList.add('hidden');
    el?.classList.remove('hidden');
  };

  if (!params.code) {
    show(error);
  } else {
    fetch(`${API_URL}/confirm`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        code: params.code,
      }),
    })
      .then((response) => {
        if (response.ok) {
          show(success);
        } else {
          show(error);
        }
      })
      .catch(() => {
        show(error);
      });
  }
</script>
