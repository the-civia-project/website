---
import Image from '../assets/og/index.webp';
import HandWavingIcon from '../assets/icons/hand-waving.svg';
import Link from '../components/Link.astro';
import Strong from '../components/Strong.astro';
import U from '../components/U.astro';
import Layout from '../layouts/Layout.astro';

const image_url = new URL(Image.src, Astro.site);

const description =
  'Make the world more resilient towards and better equipped against fake news, propaganda, disinformation, misinformation and malinformation.';
---

<Layout centered>
  <Fragment slot="header">
    <title>The Civia Project &mdash; Real People. Real Talk.</title>

    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image_url} />

    <!-- X Card -->
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image_url} />
  </Fragment>

  <aside
    class="border-l-2 border-zinc-700 py-1 pl-6 [&_p]:mt-3 [&_p]:italic [&_p]:leading-relaxed [&_p]:text-zinc-300"
  >
    <span class="block text-xs uppercase tracking-widest text-zinc-500"
      >Mission</span
    >
    <p>
      Make the world <Strong>more resilient</Strong> towards and <Strong
        >better equipped</Strong
      > against <U>fake news</U>, <U>propaganda</U>, <U>disinformation</U>, <U
        >misinformation</U
      > and <U>malinformation</U>.
    </p>
  </aside>

  <p class="text-xl leading-relaxed text-zinc-100">
    We are <Strong>building in public</Strong> the first <U>public</U> and <U
      >transparent</U
    >
    <Strong>civic social media platform</Strong> built on <U
      >strong privacy primitives</U
    > with the <Strong>users' benefit</Strong> in mind, not <em
      >&ldquo;capital gains&rdquo;</em
    >.
  </p>

  <aside
    class="border-l-2 border-zinc-700 py-1 pl-6 [&_li]:italic [&_li]:leading-relaxed [&_li]:text-zinc-300 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5"
  >
    <span class="block text-xs uppercase tracking-widest text-zinc-500"
      >Help us grow</span
    >
    <ul>
      <li>Print flyers, posters, and stickers (PDFs)</li>
      <li>Use logo and brand assets</li>
      <li>Share ready-made social posts</li>
      <li>Spread the word in your community</li>
    </ul>
  </aside>

  <Link path="/help-us-grow" variant="secondary" class="mt-4 w-full">
    <HandWavingIcon slot="icon" class="fill-current" />
    Help us grow
  </Link>
</Layout>
