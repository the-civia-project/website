---
import Image from '../assets/og/index.webp';
import Strong from '../components/Strong.astro';
import U from '../components/U.astro';
import Layout from '../layouts/Layout.astro';

const image_url = new URL(Image.src, Astro.site);

const description =
  'Make the world more resilient towards and better equipped against fake news, propaganda, disinformation, misinformation and malinformation.';
---

<Layout centered>
  <Fragment slot="header">
    <title>The Civia Project &mdash; Real People. Real Talk.</title>

    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image_url} />

    <!-- X Card -->
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image_url} />
  </Fragment>


    <span class="block text-xs uppercase tracking-widest text-zinc-500"
      >Mission</span
    >
    <p>
      Build a socially responsible social media platform that is <Strong>open-source</Strong>, <Strong>privacy-preserving</Strong>, and <Strong>civic-minded</Strong>. And through this enable people to connect and communicate in a way that is <Strong>trustworthy</Strong>, <Strong>accountable</Strong>, and <Strong>ethical</Strong>.
    </p>


</Layout>
