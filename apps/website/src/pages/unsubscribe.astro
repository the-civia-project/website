---
import HandWaving from '@the-civia-project/assets/icons/hand-waving.svg';
import Label from '../components/article/Label.astro';
import Layout from '../layouts/Layout.astro';

const description =
  'You have successfully unsubscribed from The Civia Project newsletter.';
---

<Layout centered>
  <Fragment slot="header">
    <title>The Civia Project &mdash; Unsubscribed</title>
    <meta name="description" content={description} />
  </Fragment>

  <header>
    <Label>Newsletter</Label>
    <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">Goodbye</h1>
    <p class="mt-4 leading-relaxed text-zinc-700 dark:text-zinc-300">
      You have been removed from our mailing list. We will not send you any
      further updates unless you choose to subscribe again.
    </p>
  </header>

  <aside
    class:list={[
      // layout
      'border-l-2 border-zinc-300 py-1 pl-6 dark:border-zinc-700',
      // descendants
      '[&_p]:mt-3 [&_p]:italic [&_p]:leading-relaxed [&_p]:text-zinc-700 dark:[&_p]:text-zinc-300',
    ]}
  >
    <div class="flex items-center gap-2">
      <HandWaving class="w-5 shrink-0 animate-wiggle" />
      <Label class="!mt-0">All done</Label>
    </div>
    <p>You have successfully unsubscribed from our newsletter!</p>
  </aside>
</Layout>

<script>
  import { API_URL } from 'astro:env/client';

  const urlSearchParams = new URLSearchParams(window.location.search);
  const params = Object.fromEntries(urlSearchParams.entries());

  if (params.who) {
    fetch(`${API_URL}/unsubscribe`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: params.who,
      }),
    }).catch(() => {});
  }
</script>
