const mission_post = `Make the world more resilient towards and better equipped against fake news, propaganda, disinformation, misinformation and malinformation.

https://theciviaproject.org
#TheCiviaProject #Disinformation`;

const intro_post = `We are building in public the first public and transparent civic social media platform built on strong privacy primitives with the users' benefit in mind, not "capital gains".

Make the world more resilient towards and better equipped against fake news, propaganda, disinformation, misinformation and malinformation.

https://theciviaproject.org
#TheCiviaProject #CivicTech #Privacy`;

const brand_post = `The Civia Project is building a civic social media platform with privacy and people first — not profit.

Real People. Real Talk.

Learn more: https://theciviaproject.org

#TheCiviaProject #CivicTech #Privacy #SocialMedia`;

const community_post = `We're building @TheCiviaProject — a public, transparent civic social media platform with strong privacy and users' benefit in mind.

Real People. Real Talk.

https://theciviaproject.org

#CivicTech #Privacy #OpenSource`;

const share_social_paper_goal = `"The goal is a fundamentally rebuilt social web: one engineered for human well-being, where users are protected, companies are mere guests, and capital gains are permanently removed from the equation."

— Social Paper: https://theciviaproject.org/social-paper
#TheCiviaProject #CivicTech`;

const share_social_paper_privacy = `"To reclaim user agency and move beyond the era of surveillance capitalism, privacy can no longer be treated as a premium UI feature, an obscure setting, or a corporate promise. It must be woven directly into the Web's DNA."

— Social Paper: https://theciviaproject.org/social-paper
#Privacy #TheCiviaProject`;

const share_social_paper_companies = `"In a human social network, power must flow from verified people outward. Corporations may participate in the conversation, but they do not architect the venue, own behavioral data, or decide by default what humans see in their feeds."

— Social Paper: https://theciviaproject.org/social-paper
#TheCiviaProject #SocialMedia`;

const share_technical_paper_identity = `"Every user account must be linked to a verified digital identity. The platform enforces a simple hierarchy: one human, one account. Bots, automated agents, and unverified entities cannot hold user accounts."

— Technical Paper: https://theciviaproject.org/technical-paper
#TheCiviaProject #DigitalIdentity`;

const share_technical_paper_lanes = `"Every post on the platform is explicitly public or private. Users choose visibility at publish time. The two lanes share identity verification and account infrastructure, but their data paths are architecturally separated — a private post never enters the public vector store."

— Technical Paper: https://theciviaproject.org/technical-paper
#Privacy #TheCiviaProject`;

const share_technical_paper_governance = `"The platform's code, algorithms, and identity flows are open to public scrutiny. Independent security audits, a public bug bounty program, and transparent governance ensure the architecture described in this paper matches the system users actually run."

— Technical Paper: https://theciviaproject.org/technical-paper
#OpenSource #TheCiviaProject`;

const tagline_post = `Real People. Real Talk.

@TheCiviaProject is building a civic social media platform — privacy and people first, not profit.

https://theciviaproject.org
#TheCiviaProject #CivicTech`;

const post_building_in_public = `We are building in public the first public and transparent civic social media platform — with strong privacy primitives and users' benefit in mind, not "capital gains".

Follow along: https://theciviaproject.org
@TheCiviaProject
#TheCiviaProject #OpenSource #CivicTech`;

const share_social_paper_connection = `"The social in social media has been overshadowed by the media of advertising. Their fundamental purpose should be to serve as a vector for genuine human connection."

— Social Paper: https://theciviaproject.org/social-paper
#TheCiviaProject #SocialMedia`;

const share_social_paper_feed_choice = `"Users should be able to select the feed that suits them: a reverse-chronological timeline by default, or a local-only algorithmic feed when they explicitly opt in. The algorithm must never be imposed."

— Social Paper: https://theciviaproject.org/social-paper
#TheCiviaProject #CivicTech`;

const share_social_paper_nonprofit = `"The digital town square should not be owned by a for-profit corporation beholden to the Stock Market. Instead, social media platforms should be stewarded by non-profit organizations."

— Social Paper: https://theciviaproject.org/social-paper
#TheCiviaProject #OpenSource`;

const share_technical_paper_privacy_structure = `"Privacy is woven into the architecture — not offered as a toggle buried in settings. Intent is computed locally; filters are maintained on-device."

— Technical Paper: https://theciviaproject.org/technical-paper
#Privacy #TheCiviaProject`;

const post_community_over_capital = `We believe social media should not be influenced by capital needs but by the needs of its community. The platform's main responsibility should be its users' benefits — not profit margins or corporate interests.

https://theciviaproject.org/about
@TheCiviaProject
#TheCiviaProject #CivicTech`;

const flyers: FlyerExampleData[] = [
  {
    title: 'General awareness',
    description:
      'Logo, tagline, and URL — hand out at events or leave at cafés and community boards.',
    href: '/grow/flyer-awareness.pdf',
    download: 'civia-flyer-awareness.pdf',
  },
  {
    title: 'Mission statement',
    description:
      'Lead with our mission against disinformation — ideal for policy meetups and civic groups.',
    href: '/grow/flyer-mission.pdf',
    download: 'civia-flyer-mission.pdf',
  },
  {
    title: 'Event / community',
    description:
      'Date, time, and venue layout for meetups, tabling, and local outreach.',
    href: '/grow/flyer-event.pdf',
    download: 'civia-flyer-event.pdf',
  },
  {
    title: 'Introduction',
    description:
      'Who we are and what we are building — a simple intro for first-time readers.',
    href: '/grow/flyer-intro.pdf',
    download: 'civia-flyer-intro.pdf',
  },
];

const posters: PosterExampleData[] = [
  {
    title: 'General awareness',
    description:
      'Bold headline layout for windows, walls, and public spaces.',
    href: '/grow/poster-awareness.pdf',
    download: 'civia-poster-awareness.pdf',
  },
  {
    title: 'Mission statement',
    description:
      'Feature our mission for community centers, libraries, and civic spaces.',
    href: '/grow/poster-mission.pdf',
    download: 'civia-poster-mission.pdf',
  },
  {
    title: 'Event / community',
    description:
      'Leave room for date, time, and venue — ideal for meetups and talks.',
    href: '/grow/poster-event.pdf',
    download: 'civia-poster-event.pdf',
  },
  {
    title: 'Community outreach',
    description:
      'Share locally at cafés, co-working spaces, and notice boards.',
    href: '/grow/poster-community.pdf',
    download: 'civia-poster-community.pdf',
  },
];

const stickers: StickerExampleData[] = [
  {
    title: 'Real People. Real Talk.',
    description:
      'Logo with our tagline — for laptops, notebooks, and water bottles.',
    href: '/grow/stickers-tagline.pdf',
    download: 'civia-stickers-tagline.pdf',
  },
  {
    title: 'Mission statement',
    description:
      'Logo with our mission against disinformation — ideal for civic events.',
    href: '/grow/stickers-mission.pdf',
    download: 'civia-stickers-mission.pdf',
  },
  {
    title: 'The Civia Project',
    description:
      'Logo with our name — simple brand mark for any surface.',
