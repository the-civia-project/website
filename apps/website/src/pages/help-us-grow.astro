---

<Layout size="large">
  <Fragment slot="header">
    <title>Help Us Grow &mdash; The Civia Project</title>

    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image_url} />

    <!-- X Card -->
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image_url} />
  </Fragment>

  <header class="flex items-start justify-between gap-4">
    <div>
      <span class="block text-xs uppercase tracking-widest text-zinc-500"
        >Spread the word</span
      >
      <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
        Help Us Grow
      </h1>
    </div>
    <PrintPdfButton />
  </header>

  <p class="text-lg leading-relaxed text-zinc-300">
    Print flyers, share our logo, post our message. Everything here is free to
    use under <a
      href="https://creativecommons.org/licenses/by-sa/4.0/"
      target="_blank"
      class="underline hover:text-white">CC BY-SA 4.0</a
    > — help us reach people who care about civic tech and privacy.
  </p>

  <section class={section}>
    <h2 class="text-2xl font-bold leading-snug text-white">Logo pack</h2>
    <p>Download our logo for websites, slides, and print materials.</p>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <ResourceCard
        title="Logo mark"
        description="SVG and PNG versions for light and dark backgrounds."
      >
        <div slot="preview" class="flex items-center justify-center gap-8 p-8">
          <div class="rounded-sm bg-zinc-950 p-4">
            <img src="/grow/logo.svg" alt="" width="54" height="64" class="h-16 w-auto" />
          </div>
          <div class="rounded-sm bg-white p-4">
            <img src="/grow/logo.svg" alt="" width="54" height="64" class="h-16 w-auto" />
          </div>
        </div>
        <div slot="actions">
          <GrowDownloadLink href="/grow/logo.svg" download="civia-logo.svg">
            SVG
          </GrowDownloadLink>
          <GrowDownloadLink href="/grow/logo-dark.png" download="civia-logo-dark.png">
            PNG (dark)
          </GrowDownloadLink>
          <GrowDownloadLink href="/grow/logo-light.png" download="civia-logo-light.png">
            PNG (light)
          </GrowDownloadLink>
        </div>
      </ResourceCard>

      <ResourceCard
        title="QR code"
        description="Scan to visit theciviaproject.org — add to flyers, stickers, or slides."
      >
        <div slot="preview" class="flex items-center justify-center p-8">
          <img src="/grow/qr-code.svg" alt="QR code for theciviaproject.org" width="160" height="160" class="size-40 bg-white p-2" />
        </div>
        <div slot="actions">
          <GrowDownloadLink href="/grow/qr-code.svg" download="civia-qr-code.svg">
            Download SVG
          </GrowDownloadLink>
        </div>
      </ResourceCard>
    </div>
  </section>

  <section class={section}>
    <h2 class="text-2xl font-bold leading-snug text-white">Print materials</h2>
    <p>Download PDF flyers and posters for printing at home or at a print shop.</p>

    <h3 class="mt-8 text-lg font-bold text-white">Flyers</h3>
    <p class="mt-2 text-sm text-zinc-400">
      Four A4 layouts to choose from — download the PDF and print on A4 paper.
    </p>

    <FlyerExampleList {flyers} />

    <h3 class="mt-10 text-lg font-bold text-white">Posters</h3>
    <p class="mt-2 text-sm text-zinc-400">
      Four A3 layouts to choose from — download the PDF and print on A3 paper.
    </p>

    <PosterExampleList {posters} />

    <h3 class="mt-10 text-lg font-bold text-white">Stickers</h3>
    <p class="mt-2 text-sm text-zinc-400">
      Four sticker sheet layouts to choose from — download the PDF and print on
      sticker paper.
    </p>

    <StickerExampleList {stickers} />
  </section>

  <section class={section}>
    <h2 class="text-2xl font-bold leading-snug text-white">Social posts</h2>
    <p>
      Ready-to-share posts for X, Bluesky, Mastodon, and other platforms — copy
      the text or share directly from your device.
    </p>

    <div class="mt-6">
      <CopyCarousel
        items={[
          { label: 'Mission post', text: mission_post, Icon: ChecksIcon },
          { label: 'Intro post', text: intro_post, Icon: RocketIcon },
          { label: 'Brand post', text: brand_post, Icon: UsersIcon },
          {
            label: 'Community post',
            text: community_post,
            Icon: UsersIcon,
          },
          {
            label: 'Share — Rebuilt social web',
            text: share_social_paper_goal,
            Icon: HandWavingIcon,
          },
          {
            label: 'Share — Privacy in the DNA',
            text: share_social_paper_privacy,
            Icon: WarningIcon,
          },
          {
            label: 'Share — Companies as guests',
            text: share_social_paper_companies,
            Icon: HandIcon,
          },
          {
            label: 'Share — People first, bots never',
            text: share_technical_paper_identity,
            Icon: CircleNotchIcon,
          },
          {
            label: 'Share — Public & private lanes',
            text: share_technical_paper_lanes,
            Icon: WrenchIcon,
          },
          {
            label: 'Share — Open governance',
            text: share_technical_paper_governance,
            Icon: ChecksIcon,
          },
          {
            label: 'Post — Real People. Real Talk.',
            text: tagline_post,
            Icon: HandWavingIcon,
          },
          {
            label: 'Post — Building in public',
            text: post_building_in_public,
            Icon: RocketIcon,
          },
          {
            label: 'Share — Human connection first',
            text: share_social_paper_connection,
            Icon: WarningIcon,
          },
          {
            label: 'Share — Feed choice restored',
            text: share_social_paper_feed_choice,
            Icon: CircleNotchIcon,
          },
          {
            label: 'Share — Non-profit stewardship',
            text: share_social_paper_nonprofit,
            Icon: HandIcon,
          },
          {
            label: 'Share — Privacy as structure',
            text: share_technical_paper_privacy_structure,
            Icon: WrenchIcon,
          },
          {
            label: 'Post — Community over capital',
            text: post_community_over_capital,
            Icon: UsersIcon,
          },
        ]}
      />
    </div>
  </section>

</Layout>

<script>
  document.addEventListener('click', async (event) => {
    const copy_btn = (event.target as HTMLElement).closest('[data-copy-target]');
    if (copy_btn) {
      const id = copy_btn.getAttribute('data-copy-target');
      const el = id ? document.getElementById(id) : null;
      if (!el) return;
      await navigator.clipboard.writeText(el.textContent ?? '');
      const label_el = copy_btn.querySelector('[data-copy-label]') ?? copy_btn;
      const original = label_el.textContent;
      label_el.textContent = 'Copied!';
      window.setTimeout(() => {
        label_el.textContent = original;
      }, 2000);
      return;
    }

    const print_btn = (event.target as HTMLElement).closest('[data-grow-print]');
    if (!print_btn) return;

    const target = print_btn.getAttribute('data-grow-print');
    if (!target) return;

    document.body.dataset.growPrint = target;
    window.print();
  });

  window.addEventListener('afterprint', () => {
    delete document.body.dataset.growPrint;
  });
</script>
