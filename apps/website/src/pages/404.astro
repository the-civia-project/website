---
import HandIcon from '@the-civia-project/assets/icons/hand.svg';
import Image from '@the-civia-project/assets/og/404.webp';
import Label from '../components/article/Label.astro';
import Layout from '../layouts/Layout.astro';

const image_url = new URL(Image.src, Astro.site);

const description = 'This is not the page you are looking for!';
---

<Layout centered>
  <Fragment slot="header">
    <title>The Civia Project &mdash; 404</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image_url} />

    <!-- X Card -->
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image_url} />
  </Fragment>

  <header class="relative">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-4 right-0 select-none text-7xl font-bold tabular-nums text-zinc-900 md:-top-8 md:text-9xl"
      >404</span
    >
    <Label>Error</Label>
    <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
      Page Not Found
    </h1>
    <p class="mt-4 leading-relaxed text-zinc-300">
      The page you requested does not exist, may have moved, or the URL might
      be misspelled.
    </p>
  </header>

  <aside
    class="border-l-2 border-zinc-700 py-1 pl-6 [&_p]:mt-3 [&_p]:italic [&_p]:leading-relaxed [&_p]:text-zinc-300"
  >
    <div class="flex items-center gap-2">
      <HandIcon class="w-5 shrink-0 animate-pulse" />
      <Label class="!mt-0">Jedi wisdom</Label>
    </div>
    <p>This is not the page you are looking for.</p>
  </aside>
</Layout>
