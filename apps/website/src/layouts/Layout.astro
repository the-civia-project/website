---
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  centered?: boolean;
  size?: 'medium' | 'large';
}

const { centered = false, size = 'medium' } = Astro.props;

const size_class = size === 'medium' ? 'md:w-150' : 'md:w-175';
---

<BaseLayout>
  <Fragment slot="header">
    <slot name="header" />
  </Fragment>

  <div
    class:list={[
      'flex flex-1 justify-center',
      centered ? 'items-center' : 'items-start',
    ]}
    transition:name="content"
  >
    <main
      class:list={[
        // layout
        'flex w-full flex-col gap-8',
        size_class,
        // print — layout
        'print:w-full print:max-w-none',
      ]}
    >
      <a
        href="/"
        class:list={[
          // layout
          'flex items-center gap-4',
          // print — display
          'print:hidden',
        ]}
      >
        <Logo />
        <div>
          <h1
            class:list={[
              // typography
              'text-center text-xl font-bold md:text-3xl',
            ]}
          >
            The Civia Project
          </h1>
          <h2
            class:list={[
              // typography
              'text-xs italic opacity-50',
            ]}
          >
            Real People. Real Talk.
          </h2>
        </div>
      </a>

      <hr
        class:list={[
          // opacity
          'opacity-25',
          // print — display
          'print:hidden',
        ]}
      />

      <slot />

      <div
        class:list={[
          // layout
          'mt-10',
          // print — display
          'print:hidden',
        ]}
      >
        <Footer />
      </div>
    </main>
  </div>
</BaseLayout>
