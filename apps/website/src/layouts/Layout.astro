---
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  centered?: boolean;
  size?: 'medium' | 'large';
}

const { centered = false, size = 'medium' } = Astro.props;

const size_class = size === 'medium' ? 'md:w-150' : 'md:w-175';
---

<BaseLayout>
  <Fragment slot="header">
    <slot name="header" />
  </Fragment>

  <div
    class:list={[
      'flex flex-1 justify-center',
      centered ? 'items-center' : 'items-start',
    ]}
    transition:name="content"
  >
    <main class:list={['flex w-full flex-col', 'gap-8', size_class]}>
      <a href="/" class="print:hidden flex items-center gap-4">
        <Logo />
        <div>
          <h1 class="text-xl md:text-3xl font-bold text-center">
            The Civia Project
          </h1>
          <h2 class="text-xs opacity-50 italic">Real People. Real Talk.</h2>
        </div>
      </a>

      <hr class="print:hidden opacity-25" />

      <slot />

      <div class="print:hidden mt-10">
        <Footer />
      </div>
    </main>
  </div>
</BaseLayout>
