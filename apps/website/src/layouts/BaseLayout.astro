---
import '@fontsource-variable/inter';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

const canonical_url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="canonical" href={canonical_url} />
    <meta
      name="keywords"
      content="civia, project, social, media, platform, privacy, ngo, non-profit, organization"
    />

    <!-- Open Graph -->
    <meta property="og:title" content="The Civia Project" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical_url} />

    <!-- X Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="The Civia Project" />
    <meta name="twitter:site" content="@TheCiviaProject" />

    <script is:inline>
      (function () {
        var key = 'theme';
        var stored = localStorage.getItem(key);
        var dark;
        if (stored === 'dark') dark = true;
        else if (stored === 'light') dark = false;
        else dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

    <slot name="header" />

    <ClientRouter />
  </head>
  <body
    class:list={[
      // layout
      'flex min-h-screen flex-col p-8 md:p-8',
      // color
      'bg-white text-zinc-950 dark:bg-black dark:text-white',
      // print — layout
      'print:min-h-0 print:block print:p-0',
    ]}
  >
    <slot />

    <script>
      import { initTheme } from '../lib/theme';

      initTheme();
      document.addEventListener('astro:page-load', initTheme);
    </script>
  </body>
</html>
