---
import DefaultImage from "../assets/Edwin_Andrade.unsplash.webp";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(DefaultImage.src, Astro.site);

const description =
    "Designing the worlds next generation social media platform around free-speech, truth, transparency and trust. A platform by the people, for the people!";
---

<BaseLayout>
    <Fragment slot="header">
        <title>The Civia Project &mdash; Real People. Real Talk.</title>

        <link rel="canonical" href={canonicalURL} />

        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="civia, project, social, media, platform"
        />

        <!-- Open Graph -->
        <meta property="og:title" content="The Civia Project" />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={imageUrl} />

        <!-- X Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="The Civia Project" />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:site" content="@TheCiviaProject" />
    </Fragment>

    <div
        class="pointer-events-auto w-full h-full overflow-auto flex md:justify-center pt-12"
    >
        <main class="md:w-180 w-full text-center">
            <div transition:name="title">
                <h1 class="font-display inline-flex flex-col">
                    <span class="text-left pl-2 md:pl-8 text-xs">The</span>
                    <span class="text-5xl/9 md:text-9xl/24">Civia</span>
                    <span class="text-right md:pr-1 text-xs">Project</span>
                </h1>
                <h2 class="opacity-50 italic">Real People. Real Talk.</h2>
            </div>

            <p class="text-left p-8 md:px-0 leading-12 tracking-wider">
                The <strong>World</strong> needs a next-generation social platform
                built for <u>free-speech</u>, <u>truth</u>, <u>transparency</u>,
                and <u>trust</u>. Only people,
                <mark class="blue">real people</mark> &mdash;
                <mark class="amber">not bots</mark>
                ,
                <mark class="orange">trolls</mark>
                , or
                <mark class="red">anonymous bad actors</mark> &mdash; should drive
                the conversation.
            </p>

            <p class="text-left p-8 md:px-0 leading-12 tracking-wider">
                A platform that is designed to counter
                <mark class="rose">misinformation</mark>
                and
                <mark class="pink">propaganda</mark>
                , that prioritizes <strong>evidence-based discourse</strong>, <strong
                    >algorithmic transparency</strong
                >, and <strong>civic responsibility</strong>. Whether you are <u
                    >engaging in public debate</u
                >,
                <u>sharing knowledge</u>, <u>building communities</u> or
                <u>interacting with your friends, family or co-workers</u> &mdash;
                the platform should <strong>empower</strong> thoughtful expressions
                in a
                <mark class="lime">safe</mark>
                and
                <mark class="green">accountable</mark>
                environment.
            </p>

            <p class="text-left p-8 md:px-0 leading-12 tracking-wider">
                If you are interested to join, participate or share anything
                with us, feel free to write us an email at
                <a
                    class="underline"
                    href="mailto:theciviaproject@protonmail.com"
                    >theciviaproject@protonmail.com</a
                >.
            </p>

            <div
                transition:name="navigation"
                class="pointer-events-auto justify-center flex flex-col md:flex-row md:px-16 mb-8 md:mb-16 flex-wrap"
            >
                <Menu />
            </div>

            <Footer />
        </main>
    </div>
</BaseLayout>
