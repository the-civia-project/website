---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
---
<Layout>
  <Fragment slot="header">
    <title>Civia &mdash; Contact</title>
  </Fragment>

  <div class="w-full h-full flex justify-center items-center">
    <main class="w-180 text-center">
      <h1 class="text-4xl">Contact</h1>

      <p class="my-16">
        Feel free to contact us at <a href="mailto:people@civia.eu" class="pointer-events-auto underline">people@civia.eu</a>
        about
        anything.
      </p>
    </main>
  </div>
</Layout>
