---
import SocialLinks from "./SocialLinks.astro";
import { Image } from "astro:assets";

const startYear = 2025;
const endYear = new Date().getFullYear();
---
<div transition:name="footer" class="pointer-events-auto">
  <SocialLinks />

  <div class="p-8" />

  <div class="border-white/25 p-12 border-t flex flex-col md:flex-row gap-4 justify-center text-center">
    <div class="opacity-50 text-shadow-lg">
      &copy; {startYear === endYear ? endYear :
      <Fragment>{startYear} &mdash; {endYear}</Fragment>} Civia
    </div>

    <a href="/donate" rel="prefetch"
       class="ease-linear duration-300 text-shadow-lg opacity-50 hover:opacity-100">Donate</a>
    <a href="/the-team" rel="prefetch" class="ease-linear duration-300 text-shadow-lg opacity-50 hover:opacity-100">The
      team</a>
    <a href="/contact" rel="prefetch" class="ease-linear duration-300 text-shadow-lg opacity-50 hover:opacity-100">Contact</a>
  </div>

  <div class="text-xs flex gap-1 justify-center">
    <div>
      <span class="opacity-50">Content licensed under</span>
      <a
        class="opacity-50 hover:opacity-100"
        target="_blank"
        href="https://creativecommons.org/licenses/by-sa/4.0/"
      >
        CC BY-SA 4.0
      </a>
    </div>
    <Image
      inferSize={true} alt="CC" class="inline w-4 opacity-50"
      src="https://mirrors.creativecommons.org/presskit/icons/cc.svg"
    />
    <Image
      inferSize={true} alt="BY" class="inline w-4 opacity-50"
      src="https://mirrors.creativecommons.org/presskit/icons/by.svg"
    />
    <Image
      inferSize={true} alt="SA" class="inline w-4 opacity-50"
      src="https://mirrors.creativecommons.org/presskit/icons/sa.svg"
    />
  </div>
  <div class="text-xs mt-1 flex justify-center">
    <a href="/licenses-and-acknowledgements"
       class="ease-linear duration-300 text-shadow-lg opacity-50 hover:opacity-100">Licenses & Acknowledgements</a>
  </div>
</div>
