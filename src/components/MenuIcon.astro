<civia-menu-icon class="pointer-events-auto fill-white p-4 inline-block">
  <svg xmlns="http://www.w3.org/2000/svg" id="Outline" viewBox="0 0 24 24" width={24} height={24}>
    <rect y="4" width="24" height="2" rx="1" />
    <rect y="11" width="24" height="2" rx="1" />
    <rect y="18" width="24" height="2" rx="1" />
  </svg>
</civia-menu-icon>

<script>
  class MenuIcon extends HTMLElement {
    #svg!: SVGSVGElement;

    connectedCallback() {
      const svg = this.querySelector("svg");

      if (!svg) {
        throw new Error("No SVGSVGElement available");
        }


      this.#svg = svg;

      this.addEventListener("click", () => {
        this.#svg.classList.toggle("active");
        });
      }
    }

    customElements.define("civia-menu-icon", MenuIcon);
</script>

<style>
civia-menu-icon rect {
  transition: all 0.3s ease-in-out;
  transform: translate(0, 0) rotate(0deg);
}

.active rect:first-child {
  transform: translate(29%, -2%) rotate(45deg);
}

.active rect:nth-child(2) {
  opacity: 0;
}

.active rect:nth-child(3) {
  transform: translate(-41%, 28%) rotate(-45deg)
}
</style>
