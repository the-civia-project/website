---
import GitHub from "../assets/social/github.svg";
import Instagram from "../assets/social/instagram.svg";
import Twitter from "../assets/social/twitter.svg";

const size = 16;
---

<div class="flex gap-4 fill-white justify-center">
    <a href="#" target="_blank" title="The Civia Project on X">
        <Twitter width={size} height={size} />
    </a>
    <a href="#" target="_blank" title="The Civia Project on Instagram">
        <Instagram width={size} height={size} />
    </a>
    <a
        href="https://github.com/the-civia-project"
        target="_blank"
        title="The Civia Project on Github"
    >
        <GitHub width={size} height={size} />
    </a>
</div>
